# Copy this file to .env and fill in the values from your own Google Cloud
# project. Full step-by-step instructions: see "Google Cloud setup" in
# README.md. None of these are secrets — they're public OAuth client
# identifiers — but they're specific to your Google Cloud project, so they
# aren't committed to git.

# Web application OAuth client ID (used by @react-native-google-signin at
# runtime on both Android and iOS — yes, the "Web" one, that's intentional).
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS OAuth client's reversed-domain URL scheme, needed only for iOS builds.
# Example: com.googleusercontent.apps.123456789012-abcdefghijklmnop
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
